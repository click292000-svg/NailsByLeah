# Copy to .env.local and adjust. Never commit real keys (.env.local is git-ignored).

# Base URL of the C# API. Keep "/api" in development: the Vite dev server proxies it to https://localhost:7199.
# In production use a relative path or an https:// URL.
VITE_API_BASE_URL=/api

# Optional Google Maps Embed API key. Without it the keyless embed is used.
VITE_GOOGLE_MAPS_API_KEY=

# Automatic logout after this many idle minutes (must match the backend Auth:SessionIdleTimeoutMinutes).
VITE_SESSION_IDLE_MINUTES=30
