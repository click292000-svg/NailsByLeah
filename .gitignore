# Nails by Leyah: what never goes to GitHub. (frontend/.gitignore adds node_modules, dist and .env.local.)

# Real data: database backups hold clients' names, emails and phone numbers; App_Data holds their design photos.
backups/
*.bak
backend/App_Data/

# Build output and caches
bin/
obj/
.vs/
TestResults/
node_modules/
dist/
# The built website, copied from frontend/dist
backend/wwwroot/

# Personal and machine-specific settings (passwords live in dotnet user-secrets, outside this folder)
*.user
*.local
.env.local
.claude/
.vscode/*
!.vscode/extensions.json

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# Leftover from the GitHub repository's first commit
/NailsByLeah/
